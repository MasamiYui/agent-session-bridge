{
  "name": "agent-session-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "vitest run src",
    "check": "tsc -b",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:gui": "playwright test",
    "test:integration": "python3 scripts/integration-smoke.py",
    "dev:demo": "VITE_DEMO=1 vite --host 127.0.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0"
  }
}
